<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 🌟 ТЕМА ДЛЯ ЭКРАНА ЗАСТАВКИ (SPLASH SCREEN) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Цвет фона заставки (можете заменить на ваш @color/background) -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>

        <!-- Иконка или логотип по центру (замените ic_launcher на свой логотип, если есть) -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>


        <!-- Основная тема, которая включится автоматически после скрытия заставки -->
        <item name="postSplashScreenTheme">@style/Theme.FocusApp</item>
    </style>

    <!-- Ваша основная тема приложения -->
    <style name="Theme.FocusApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Основные цвета -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorTertiary">@color/tertiary</item>

        <!-- Цвета текста -->
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_secondary</item>

        <!-- Фоны -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="android:colorBackground">@color/background</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/status_bar</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/surface</item>

        <!-- 🔥 ЗАПРЕЩАЕМ MIUI ПРИНУДИТЕЛЬНО ТЕМНИТЬ ПРИЛОЖЕНИЕ -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="RoundedOutlinedBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxStrokeColor">@color/selector_text_input_layout_stroke</item>
        <item name="hintTextColor">?android:attr/textColorSecondary</item>
    </style>
</resources>