<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://android.com"
    xmlns:app="http://android.com">

    <!-- Настройка перехода длительностью 400 миллисекунд -->
    <Transition
        app:constraintSetStart="@+id/start"
        app:constraintSetEnd="@+id/end"
        app:duration="400" />

    <!-- НАЧАЛЬНОЕ СОСТОЯНИЕ (Поиск строго в центре экрана) -->
    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.5" />
    </ConstraintSet>

    <!-- КОНЕЧНОЕ СОСТОЯНИЕ (Поиск улетает вверх с безопасным зазором) -->
    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/topPanel" />

        <!-- Кнопки внутри контейнера плавно исчезают во время движения -->
        <Constraint
            android:id="@+id/bottomButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.0"
            android:visibility="gone" />
    </ConstraintSet>

</MotionScene>
