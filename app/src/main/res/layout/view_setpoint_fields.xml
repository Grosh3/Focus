<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/RoundedOutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Позиция"
        android:layout_marginBottom="8dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPositionName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/RoundedOutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Описание"
        android:layout_marginBottom="8dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSetpointName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/RoundedOutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Уставка"
        android:layout_marginBottom="8dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSetpointValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/RoundedOutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Выдержка времени"
        android:layout_marginBottom="8dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDelayTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/RoundedOutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Операция"
        android:layout_marginBottom="8dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etOperation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/RoundedOutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Расположение"
        android:layout_marginBottom="8dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSetpointLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/RoundedOutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Примечания"
        android:layout_marginBottom="8dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:maxLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/RoundedOutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Группа оборудования (для поиска)"
        android:layout_marginBottom="8dp"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_arrow_down">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEquipmentGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:focusable="false"
            android:cursorVisible="false" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>