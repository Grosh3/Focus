<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Верхняя строка: ISY + Name + CheckBox -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvIsy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ISY"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Название"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <!-- CheckBox для добавления в список -->
            <CheckBox
                android:id="@+id/cbAddToList"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:buttonTint="?attr/colorPrimary" />
        </LinearLayout>

        <!-- Сборка + Местоположение (объединённые) -->
        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="28НВ ШК5 котел н.Б"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <!-- Расположение -->
        <TextView
            android:id="@+id/tvOnPlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Расположение: Цех 1"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Описание -->
        <TextView
            android:id="@+id/tvFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Описание: Полное имя задвижки"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- KKS -->
        <TextView
            android:id="@+id/tvKks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KKS: KKS-001"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="4dp" />

        <!-- ========================================== -->
        <!-- Разворачиваемая часть (блокировки) - ВЕРТИКАЛЬНО -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/expandedContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <!-- Блокировка открытия -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlockingOpen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Открытие-блокировки"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:visibility="gone" />

            <!-- Блокировка закрытия -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlockingClose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Закрытие-блокировки"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:visibility="gone" />

            <!-- Внешние цепи -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExternalChain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Внешние цепи"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>