<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- ========================================== -->
    <!-- 1️⃣ ВЕРХНЯЯ ЧАСТЬ — ЗАГОЛОВОК -->
    <!-- ========================================== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_measurement_title"
        android:textSize="18sp"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <!-- ========================================== -->
    <!-- 2️⃣ РАЗДЕЛИТЕЛЬНАЯ ПОЛОСА -->
    <!-- ========================================== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@android:color/darker_gray" />

    <!-- ========================================== -->
    <!-- 3️⃣ НИЖНЯЯ ЧАСТЬ — ДВЕ КНОПКИ -->
    <!-- ========================================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="16dp">

        <!-- ЛЕВАЯ КНОПКА — мВ -->
        <TextView
            android:id="@+id/tvMv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/measurement_mv"
            android:textSize="24sp"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="24dp"
            android:background="#E8E0F0"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />

        <!-- ВЕРТИКАЛЬНЫЙ РАЗДЕЛИТЕЛЬ -->
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@android:color/darker_gray" />

        <!-- ПРАВАЯ КНОПКА — Ом -->
        <TextView
            android:id="@+id/tvOhm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/measurement_ohm"
            android:textSize="24sp"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="24dp"
            android:background="#FFF8E0"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />

    </LinearLayout>

</LinearLayout>