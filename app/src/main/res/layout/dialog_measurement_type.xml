<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Заголовок -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_measurement_title"
        android:textSize="18sp"
        android:textColor="@color/measurement_dialog_title"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <!-- Разделительная полоса -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/measurement_dialog_divider" />

    <!-- Две кнопки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="16dp">

        <TextView
            android:id="@+id/tvMv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/measurement_mv"
            android:textSize="24sp"
            android:textColor="@color/measurement_dialog_text"
            android:gravity="center"
            android:padding="24dp"
            android:background="@color/measurement_dialog_mv_bg"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@color/measurement_dialog_divider" />

        <TextView
            android:id="@+id/tvOhm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/measurement_ohm"
            android:textSize="24sp"
            android:textColor="@color/measurement_dialog_text"
            android:gravity="center"
            android:padding="24dp"
            android:background="@color/measurement_dialog_ohm_bg"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />

    </LinearLayout>

</LinearLayout>