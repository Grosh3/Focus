<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Позиция (жирный) -->
        <TextView
            android:id="@+id/tvPositionName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="МН-5"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <!-- Наименование -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Осевое смещение ротора турбины до"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Уставка (жирным) -->
        <TextView
            android:id="@+id/tvSetpointValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+1,0 мм - генератор"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="2dp" />

        <!-- Операция + Notes в скобках -->
        <TextView
            android:id="@+id/tvOperation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Операция: Отключение блока"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Выдержка (всегда видна) -->
        <TextView
            android:id="@+id/tvDelayTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выдержка: 3 сек."
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="4dp" />

        <!-- Разворачиваемая часть -->
        <LinearLayout
            android:id="@+id/expandedContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:paddingTop="8dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginBottom="8dp" />

            <!-- Расположение -->
            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Расположение: отм. 9,6 м"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- 🔥 НОВОЕ: Группа оборудования -->
            <TextView
                android:id="@+id/tvEquipmentGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Группа: #ТУРБИНА"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>