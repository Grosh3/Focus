<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- ========================================== -->
        <!-- 1️⃣ ВЕРХНЯЯ СТРОКА: ЧЕКБОКС + ISY + NAME     -->
        <!-- ========================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/cbChecked"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:buttonTint="?attr/colorPrimary"
                android:padding="8dp" />

            <TextView
                android:id="@+id/tvIsy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ISY"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Задвижка"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- ========================================== -->
        <!-- 2️⃣ БЛОК СТАТУСОВ И ВРЕМЕНИ                   -->
        <!-- ========================================== -->

        <!-- Строка статуса собрано/разобрано + время -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:layout_marginStart="8dp">  <!-- 🔥 УМЕНЬШИЛИ ОТСТУП С 36dp ДО 8dp -->

            <TextView
                android:id="@+id/tvAssembleStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="СОБРАТЬ"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/holo_green_dark"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvCheckedAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:30"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/holo_green_dark"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Строка статуса двигателя -->
        <TextView
            android:id="@+id/tvMotorStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:text="подключен эл.двигатель"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_red_dark"
            android:maxLines="1"
            android:visibility="gone" />

        <!-- Строка статуса ККВ -->
        <TextView
            android:id="@+id/tvBoxStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:text="установлена ККВ"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_orange_dark"
            android:maxLines="1"
            android:visibility="gone" />

        <!-- ========================================== -->
        <!-- 3️⃣ КНОПКИ ДЕЙСТВИЙ (Двигатель, ККВ, Стрелка) -->
        <!-- ========================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginStart="0dp">

            <!-- Двигатель -->
            <ImageButton
                android:id="@+id/btnMotor"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:src="@drawable/ic_motor"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Отключить двигатель"
                android:scaleType="fitXY"
                android:padding="4dp"
                app:tint="#888888" />

            <!-- ККВ (коробка) -->
            <ImageButton
                android:id="@+id/btnBox"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:src="@drawable/ic_box"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Снять ККВ"
                android:scaleType="fitXY"
                android:padding="4dp"
                app:tint="#888888" />

            <!-- Стрелка (перемещение) - СПРАВА -->
            <ImageButton
                android:id="@+id/btnMove"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:src="@drawable/ic_move_left"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Переместить"
                android:scaleType="fitXY"
                android:padding="4dp"
                app:tint="?android:attr/textColorSecondary" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>